# Model provider for both chat and embeddings: bedrock | openai | ollama
MODEL_PROVIDER=ollama
# Optional: override the embedding provider independently of MODEL_PROVIDER
# EMBEDDING_PROVIDER=bedrock

# Leave CHAT_MODEL_ID / EMBEDDING_MODEL_ID blank to use each provider's default:
#   bedrock: us.anthropic.claude-haiku-4-5-20251001-v1:0 / amazon.titan-embed-text-v2:0
#   openai:  gpt-4o-mini / text-embedding-3-small
#   ollama:  llama3.2 / nomic-embed-text
CHAT_MODEL_ID=
EMBEDDING_MODEL_ID=

# Only needed when MODEL_PROVIDER (or EMBEDDING_PROVIDER) is bedrock.
# Reranking (pipeline/rerank.py) always calls Bedrock's hosted Cohere reranker
# regardless of MODEL_PROVIDER, so these credentials are required either way --
# the IAM identity needs bedrock:Rerank and bedrock:InvokeModel permissions,
# and Bedrock model access must be granted for cohere.rerank-v3-5:0.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Only needed when MODEL_PROVIDER (or EMBEDDING_PROVIDER) is openai
OPENAI_API_KEY=

API_URL=http://localhost:8000
